rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function inSquad(squadId) {
      return isSignedIn() && myProfile().squadId == squadId;
    }

    // A squad can have more than one coach (the founder plus any assistant
    // coaches who joined with the coach invite code) — coach status is
    // membership in this subcollection, not a single coachId field.
    function isCoachOfSquad(squadId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/squads/$(squadId)/coaches/$(request.auth.uid));
    }

    // The caller's roster "slot": which cheerleader they're linked to, and
    // whether they're the athlete or her parent. Lets a coach address a
    // thread to someone who hasn't signed up yet — the thread finds them when
    // they do. Returns a value that matches nothing for coaches (no link) so
    // it can be compared without a null check. Mirrors slotForRole() in
    // src/firebase/squad.js.
    function myLink() {
      return myProfile().get('linkedCheerleaderId', '') is string
        ? myProfile().get('linkedCheerleaderId', '')
        : '';
    }

    function mySlot() {
      return myLink() == '' ? 'none'
        : (myProfile().role == 'cheerleader' ? 'athlete:' + myLink()
        : (myProfile().role == 'parent' ? 'parent:' + myLink() : 'none'));
    }

    // A user's own profile: role, squadId, linkedCheerleaderId. Only the owner can read/write it.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /squads/{squadId} {
      // Public read: lets the sign-up flow resolve an invite code and show the squad name
      // before the person has an account yet. Only the coach doc's own fields are exposed.
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isCoachOfSquad(squadId);

      match /coaches/{uid} {
        allow read: if true;
        // Two ways to claim your own coach doc: you're the squad's founding
        // coachId (also used to self-heal squads created before this
        // subcollection existed), or you're presenting the squad's current
        // coachInviteCode as an assistant coach. Nobody can grant coach
        // status to anyone but themselves, and nobody can grant it to
        // themselves without knowing (or already being) the real thing.
        allow create: if isSignedIn() && request.auth.uid == uid && (
          get(/databases/$(database)/documents/squads/$(squadId)).data.coachId == request.auth.uid ||
          get(/databases/$(database)/documents/squads/$(squadId)).data.coachInviteCode == request.resource.data.inviteCode
        );
      }

      // Directory of every signed-up participant (coach, parents, cheerleaders),
      // used to build the "message these people" picker. Squad-only read, since
      // it exposes real display names — unlike the public roster/groups below,
      // which only ever show cheerleader names the join flow already needs.
      match /members/{uid} {
        allow read: if inSquad(squadId);
        allow create, update: if isSignedIn() && request.auth.uid == uid;
      }

      // Custom threads: a hand-picked set of people, not tied to a squad group.
      // Readable two ways — you're a member by uid, or the thread belongs to
      // your roster slot, which is how you find one started before you had an
      // account. `||` short-circuits, so threads written before memberSlots
      // existed still resolve on the first clause without tripping over the
      // missing field.
      match /threads/{threadId} {
        allow read: if inSquad(squadId) && (
          request.auth.uid in resource.data.memberIds ||
          mySlot() in resource.data.get('memberSlots', [])
        );
        allow create: if inSquad(squadId) &&
          request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.createdBy == request.auth.uid;
      }

      match /cheerleaders/{cheerleaderId} {
        // Public read: the join flow lists roster names/avatars so a cheerleader/parent can
        // pick/link the right one before signing up. Only the coach can write the roster.
        allow read: if true;
        allow write: if isCoachOfSquad(squadId);
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isCoachOfSquad(squadId);
      }

      match /groups/{groupId} {
        // Public read for the same reason as the roster: the join flow shows
        // which group a cheerleader belongs to before she has an account.
        allow read: if true;
        allow write: if isCoachOfSquad(squadId);
      }

      match /rewardTiers/{tierId} {
        allow read: if inSquad(squadId);
        allow write: if isCoachOfSquad(squadId);
      }

      match /pointHistory/{entryId} {
        allow read: if inSquad(squadId);
        allow create, delete: if isCoachOfSquad(squadId);
      }

      // Archived seasons: a snapshot of pointHistory taken when a season ends.
      match /seasons/{seasonId} {
        allow read: if inSquad(squadId);
        allow write: if isCoachOfSquad(squadId);

        match /entries/{entryId} {
          allow read: if inSquad(squadId);
          allow write: if isCoachOfSquad(squadId);
        }
      }

      match /announcements/{announcementId} {
        allow read: if inSquad(squadId);
        allow write: if isCoachOfSquad(squadId);
      }

      match /events/{eventId} {
        allow read: if inSquad(squadId);
        allow write: if isCoachOfSquad(squadId);
      }

      match /messages/{messageId} {
        allow read: if inSquad(squadId);
        allow create: if inSquad(squadId) && request.resource.data.fromId == request.auth.uid;
        allow update: if inSquad(squadId);
      }
    }
  }
}
